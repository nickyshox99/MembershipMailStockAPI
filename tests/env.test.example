# Integration Test Environment Configuration
# Copy this file to .env.test and configure your values

# LINE API Configuration for Testing
LINE_CHANNEL_ACCESS_TOKEN_TEST=your_test_channel_access_token_here
LINE_CHANNEL_ACCESS_TOKEN=your_production_channel_access_token_here

# Test User Configuration
LINE_TEST_USER_ID=your_test_user_line_id_here

# Test Web Domain
TEST_WEB_DOMAIN=https://your-test-domain.com/

# Enable/Disable Real LINE API Sending
# Set to 'true' to send real messages to LINE API
# Set to 'false' to only log what would be sent (recommended for CI/CD)
ENABLE_REAL_LINE_SENDING=false

# Database Configuration for Testing (if needed)
DB_HOST_TEST=localhost
DB_USER_TEST=test_user
DB_PASSWORD_TEST=test_password
DB_NAME_TEST=test_database
